{
  "name": "bothy",
  "version": "0.21.0",
  "private": true,
  "type": "module",
  "description": "A single-user nostr relay that runs on the Cloudflare free tier and deploys in one click.",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "sync-badge": "node scripts/sync-badge.mjs",
    "update-tooling": "node scripts/update-tooling.mjs"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.5",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.165.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261118.1": true
  }
}
