{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bothy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",

  "durable_objects": {
    "bindings": [
      { "name": "RELAY", "class_name": "Relay" }
    ]
  },

  // SQLite is the only backend the Workers Free plan can provision for a
  // new DO class — see CLAUDE.md "Architecture". Never add a KV-backed
  // migration here.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Relay"] }
  ],

  // No `vars` block here, deliberately -- the Cloudflare deploy button
  // prompts for every var declared in this file with no notion of
  // "optional", so a `RELAY_ICON` prompt would land in front of a
  // non-technical user before they have anything working (ROADMAP.md
  // chunk 5). RELAY_NAME/RELAY_DESCRIPTION/RELAY_ICON/ALLOW_FOLLOWS are
  // all read defensively in code (env.d.ts, ownership.ts, nip11.ts) with
  // hardcoded fallbacks, and OWNER_PUBKEY is deliberately absent per
  // CLAUDE.md "Ownership": a real deploy stays unclaimed (TOFU) by
  // default. Anyone who wants any of these adds the variable in the
  // Cloudflare dashboard -- the Cloudflare account is the authentication.
  // A git-connected Worker may sync vars from this config on deploy and
  // overwrite dashboard-added ones -- see README.md "Configuration".

  // Static admin page (CLAUDE.md "Admin page") -- static assets are
  // free and unlimited on Workers Free, unlike Worker/DO requests.
  // run_worker_first is required: without it, asset serving would
  // intercept `/` before the Worker's Accept-header check for NIP-11
  // ever runs.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Per-IP HTTP rate limits (src/index.ts). Cloudflare's Rate Limiting
  // binding, chosen because it runs in the runtime BEFORE the Worker's
  // code -- and therefore before the Durable Object -- rather than inside
  // the thing being protected, and because it needs no account resource
  // to provision and no user input, so a clean deploy still asks for
  // nothing (CLAUDE.md "Configuration").
  //
  // Two namespaces, because the two paths are expensive in different
  // currencies:
  //
  //   API     -- one shared counter for every HTTP path that wakes the
  //              Durable Object: /api/stats, /api/claim, the NIP-11
  //              document, the NIP-86 management POST, and the WebSocket
  //              upgrade. Shared deliberately: the guarantee worth having
  //              is "one address cannot wake the object more than 60
  //              times a minute", and per-path counters would multiply
  //              that by the number of paths. 60/minute is far above any
  //              real client -- the admin page loads /api/stats once per
  //              page load and the live feed reconnects with capped
  //              exponential backoff -- and far below what it takes to
  //              matter against the day's 100,000 requests.
  //
  //   PROFILE -- /api/profile only, at a sixth of that, because it is the
  //              one endpoint whose cost lands on somebody else: it opens
  //              outbound WebSockets to relay.damus.io and nos.lol
  //              (src/profile-lookup.ts). 10/minute is generous for its
  //              actual use, which is one person typing one pubkey into
  //              the claim form once, ever.
  //
  // Keyed by CF-Connecting-IP. Cloudflare's own guidance prefers a stable
  // user identifier over an IP "since many users may share a single IP"
  // (developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/,
  // checked 2026-08-27), but there is no user here to identify: every
  // path above is either pre-ownership or unauthenticated by design. The
  // shared-IP failure mode is a NAT'd household sharing one allowance on
  // one person's relay, which is not a real cost.
  //
  // period must be 10 or 60 (same source); limits are per Cloudflare
  // location and eventually consistent, so this bounds the shape of a
  // flood rather than counting it exactly -- which is all it needs to do.
  // namespace_id is a positive integer unique within the Cloudflare
  // account, not a resource that gets created; if you already run another
  // Worker in this account using 1001 or 1002, change these.
  //
  // Both bindings are read defensively in src/index.ts (`env.X?.limit`):
  // the Cloudflare docs do not state which plans the binding is available
  // on, so if it turns out to be unavailable here, the relay serves
  // requests unlimited rather than failing closed on every one of them.
  "ratelimits": [
    { "name": "RATE_LIMIT_API", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "RATE_LIMIT_PROFILE", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],

  // Drives the ALLOW_FOLLOWS refresh (a no-op when unset) -- see
  // src/index.ts scheduled(). One of the account-wide 5 cron triggers on
  // Workers Free.
  "triggers": {
    "crons": ["0 * * * *"]
  },

  // Workers Logs -- without this, console.error/console.log calls (e.g.
  // scheduled()'s fault-isolation logging) are discarded and only visible
  // via a live `wrangler tail`, which needs credentials we don't have.
  // Included on the Free plan: 200,000 logs/day, 3-day retention.
  // head_sampling_rate: 1 means every invocation is logged, not sampled.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
